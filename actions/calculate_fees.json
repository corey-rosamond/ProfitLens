{
  "openapi": "3.0.0",
  "info": {
    "title": "FBA Fee Calculator",
    "version": "1.0.0",
    "description": "Calculate Amazon FBA fees and profitability"
  },
  "servers": [
    {
      "url": "https://profitlens.internal",
      "description": "Internal calculation server"
    }
  ],
  "paths": {
    "/calculate_fees": {
      "post": {
        "summary": "Calculate FBA fees for a product",
        "operationId": "calculateFees",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["selling_price", "product_cost", "category"],
                "properties": {
                  "selling_price": {
                    "type": "number",
                    "description": "Product selling price on Amazon",
                    "minimum": 0
                  },
                  "product_cost": {
                    "type": "number",
                    "description": "Your cost per unit including shipping to Amazon",
                    "minimum": 0
                  },
                  "category": {
                    "type": "string",
                    "description": "Amazon product category",
                    "enum": [
                      "Home & Kitchen",
                      "Sports & Outdoors",
                      "Toys & Games",
                      "Beauty",
                      "Health & Personal Care",
                      "Electronics",
                      "Clothing & Accessories",
                      "Books",
                      "Grocery & Gourmet Food",
                      "Pet Supplies",
                      "Tools & Home Improvement",
                      "Office Products",
                      "Baby Products",
                      "Jewelry",
                      "Other"
                    ]
                  },
                  "weight_pounds": {
                    "type": "number",
                    "description": "Product weight in pounds",
                    "minimum": 0,
                    "default": 1
                  },
                  "dimensions": {
                    "type": "object",
                    "properties": {
                      "length": {
                        "type": "number",
                        "description": "Length in inches"
                      },
                      "width": {
                        "type": "number",
                        "description": "Width in inches"
                      },
                      "height": {
                        "type": "number",
                        "description": "Height in inches"
                      }
                    }
                  },
                  "units_per_order": {
                    "type": "integer",
                    "description": "Number of units for investment calculation",
                    "minimum": 1,
                    "default": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fee calculation successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fees": {
                      "type": "object",
                      "properties": {
                        "referral_fee": {
                          "type": "number",
                          "description": "Amazon referral fee"
                        },
                        "referral_fee_rate": {
                          "type": "string",
                          "description": "Referral fee percentage"
                        },
                        "fba_fulfillment_fee": {
                          "type": "number",
                          "description": "FBA fulfillment fee"
                        },
                        "monthly_storage_fee": {
                          "type": "number",
                          "description": "Estimated monthly storage fee"
                        },
                        "total_fees": {
                          "type": "number",
                          "description": "Total Amazon fees"
                        }
                      }
                    },
                    "profitability": {
                      "type": "object",
                      "properties": {
                        "net_profit": {
                          "type": "number",
                          "description": "Net profit per unit"
                        },
                        "profit_margin": {
                          "type": "string",
                          "description": "Profit margin percentage"
                        },
                        "roi": {
                          "type": "string",
                          "description": "Return on investment percentage"
                        },
                        "break_even_units": {
                          "type": "integer",
                          "description": "Units needed to break even"
                        }
                      }
                    },
                    "investment": {
                      "type": "object",
                      "properties": {
                        "total_investment": {
                          "type": "number",
                          "description": "Total investment required"
                        },
                        "potential_revenue": {
                          "type": "number",
                          "description": "Potential revenue from units"
                        },
                        "potential_profit": {
                          "type": "number",
                          "description": "Total potential profit"
                        }
                      }
                    },
                    "verdict": {
                      "type": "string",
                      "description": "Profitability assessment",
                      "enum": ["Highly Profitable", "Profitable", "Marginal", "Not Profitable"]
                    },
                    "size_tier": {
                      "type": "string",
                      "description": "Product size tier"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}